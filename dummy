earn.model_selection import StratifiedKFold\n","from sklearn.metrics import roc_auc_score\n","from lightgbm import LGBMClassifier, early_stopping\n","from catboost import CatBoostClassifier\n","\n","y_values = np.asarray(y)\n","SEEDS = [42, 7, 2024]\n","N_SPLITS = 5\n","names = [\"xgb\", \"cat\", \"lgb\"]\n","\n","cat_params = {k: (v.item() if isinstance(v, np.generic) else v)\n","              for k, v in best_catboost_model.get_params().items()}\n","\n","oof = {n: np.zeros(len(y_values)) for n in names}\n","tst = {n: np.zeros(len(X_test)) for n in names}\n","\n","for seed in SEEDS:\n","    skf = StratifiedKFold(N_SPLITS, shuffle=True, random_state=seed)\n","    for fold, (tr, va) in enumerate(skf.split(X, y_values), 1):\n","        print(f\"seed {seed} fold {fold}/{N_SPLITS}\")\n","\n","        # XGBoost\n","        m = clone(best_model)\n","        m.set_params(xgb__random_state=seed)\n","        m.fit(X.iloc[tr], y_values[tr])\n","        oof[\"xgb\"][va] += m.predict_proba(X.iloc[va])[:, 1] / len(SEEDS)\n","        tst[\"xgb\"] += m.predict_proba(X_test)[:, 1] / (N_SPLITS * len(SEEDS))\n","\n","        # CatBoost\n","        p = dict(cat_params); p[\"random_seed\"] = seed\n","        c = CatBoostClassifier(**p)\n","        c.fit(X_cat.iloc[tr], y_values[tr], cat_features=cat_features, verbose=0)\n","        oof[\"cat\"][va] += c.predict_proba(X_cat.iloc[va])[:, 1] / len(SEEDS)\n","        tst[\"cat\"] += c.predict_proba(X_test_cat)[:, 1] / (N_SPLITS * len(SEEDS))\n","\n","        # LightGBM (shallow + early stopping)\n","        prep = clone(tree_preprocessor)\n","        Xtr = prep.fit_transform(X.iloc[tr]); Xva = prep.transform(X.iloc[va]); Xte = prep.transform(X_test)\n","        l = LGBMClassifier(n_estimators=2000, learning_rate=0.02, num_leaves=15, max_depth=5,\n","                           min_child_samples=40, subsample=0.8, subsample_freq=1,\n","                           colsample_bytree=0.7, reg_lambda=5.0,\n","                           random_state=seed, n_jobs=-1, verbosity=-1)\n","        l.fit(Xtr, y_values[tr], eval_set=[(Xva, y_values[va])], eval_metric=\"auc\",\n","              callbacks=[early_stopping(100, verbose=False)])\n","        oof[\"lgb\"][va] += l.predict_proba(Xva)[:, 1] / len(SEEDS)\n","        tst[\"lgb\"] += l.predict_proba(Xte)[:, 1] / (N_SPLITS * len(SEEDS))\n","\n","print(\"\\nIndividual OOF AUC\")\n","for n in names:\n","    print(n, round(roc_auc_score(y_values, oof[n]), 6))\n","\n","def rk(a):\n","    return (rankdata(a) - 1) / (len(a) - 1)\n","\n","blend_oof = np.mean([rk(oof[n]) for n in names], axis=0)\n","print(\"Rank-average OOF AUC:\", round(roc_auc_score(y_values, blend_oof), 6))\n","\n","final_predictions = np.mean([rk(tst[n]) for n in names], axis=0)\n","\n","submission_3model = sample_submission.copy()\n","submission_3model[target_col] = final_predictions\n","submission_3model.to_csv(\"submission_xgb_catboost_lightgbm.csv\", index=False)\n","print(\"Saved\", submission_3model.shape)\n","display(submission_3model.head())"]},{"cell_type":"markdown","id":"fdedfa50","metadata":{"papermill":{"duration":0.011639,"end_time":"2026-10-18T10:25:00.370292+00:00","exception":false,"start_time":"2026-10-18T10:25:00.358653+00:00","status":"completed"},"tags":[]},"source":[" <span style=\"font-size:35px\">AI Usage</span>\n","\n","<span style=\"font-size:24px\">I used AI as an assistance tool throughout the process, rather than relying on it blindly. I did not use Google Colab's built-in Gemini or similar AI tools. My workflow involved first exploring and analysing the dataset, then using GPT to help generate code for specific algorithms. I evaluated the resulting scores, compared performance, and experimented with different algorithms iteratively. Since conventional models such as SVM, Logistic Regression, and Naive Bayes did not deliver satisfactory results, I focused primarily on ensemble methods that showed better potential.\n","\n","I was also working on a similar machine learning 